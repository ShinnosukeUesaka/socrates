{
  "name": "ember",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that watches what you write and dramatically flags logical fallacies right where they are.",
  "type": "module",
  "scripts": {
    "start": "node scripts/playground.mjs",
    "build": "node build.mjs",
    "icons": "node scripts/make-icons.mjs",
    "test": "npm run build && npm run test:unit && npm run test:e2e",
    "test:unit": "node --test test/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.test.mjs",
    "test:live": "node --test test/live/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1"
  }
}
