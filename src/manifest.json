{
  "manifest_version": 3,
  "name": "Socrates — Reasoning Companion",
  "short_name": "Socrates",
  "version": "0.2.0",
  "description": "Grammarly for your thinking. Flags possible reasoning errors in what you write and asks a Socratic question about each.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.openai.com/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["docs-annotate.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Socrates",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
